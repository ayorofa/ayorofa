# ═══════════════════════════════════════════════════════════
#  Variables d'environnement — Ayôrôfa Connect
#
#  En local : copiez ce fichier en .env.local et remplissez-le.
#  En production : Vercel → Settings → Environment Variables.
#
#  Les variables NEXT_PUBLIC_* sont visibles dans le navigateur.
#  Les autres restent côté serveur : ne les exposez jamais.
# ═══════════════════════════════════════════════════════════

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://connect.ayorofa.com

# ── Supabase ──
# URL et clé publique : lisibles côté navigateur, protégées par RLS.
NEXT_PUBLIC_SUPABASE_URL=https://gskwanbtfexobwkgnpxh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clé de service : contourne RLS. Elle est indispensable aux routes de
# paiement, qui doivent activer un plan sans passer par l'utilisateur.
# À ne mettre QUE côté serveur (Vercel), jamais dans un fichier public.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Paiement Mobile Money (CinetPay) ──
# Tant que ces deux clés sont vides, /api/paiement/initier répond 503
# et l'application bascule sur le paiement manuel : le membre déclare
# son versement, un administrateur le valide depuis /admin-plans.
# Une fois renseignées, le paiement Wave / Orange / MTN / Moov devient
# automatique, plan et badge « Vérifié » compris.
# Prérequis : exécuter supabase/paiements.sql, qui crée la table où les
# transactions sont enregistrées.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# ── Mesure d'audience (facultatif) ──
NEXT_PUBLIC_GA_ID=

# ── Publicité AdSense (facultatif) ──
# Identifiant client, de la forme ca-pub-XXXXXXXXXXXXXXXX.
# Attention au nom : le code lit NEXT_PUBLIC_ADSENSE_ID. Une variable
# nommée autrement n'aura aucun effet et les annonces ne s'afficheront
# jamais. Vide = aucune publicité.
NEXT_PUBLIC_ADSENSE_ID=

# ── Assistant IA (facultatif) ──
# Utilisé par /api/ia. Vide = fonctionnalité désactivée.
ANTHROPIC_API_KEY=
